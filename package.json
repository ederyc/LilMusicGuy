{
  "name": "lil-music-guy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "calibrate": "vite-node scripts/calibrate.ts",
    "desktop": "vite build && env -u ELECTRON_RUN_AS_NODE open -n \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "desktop:dev": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "models": "node scripts/download-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^45.5.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "main": "electron/main.cjs"
}
